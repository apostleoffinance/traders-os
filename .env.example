# =============================================================================
# Trader OS — environment template
# Copy to .env (repo root) and to frontend/.env.local as needed.
# Never commit real secrets.
# =============================================================================

# --- Database ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trader_os
POSTGRES_HOST=localhost
# Host port mapped to the Docker Postgres container.
# Default 5432/5433 are often taken by Homebrew/Postgres.app; this project uses 5435.
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5435/trader_os

# --- API ---
APP_NAME=Trader OS
APP_ENV=development
API_PREFIX=/api
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000

# --- Default display timezone (IANA) ---
DEFAULT_TIMEZONE=Africa/Lagos

# --- Object storage ---
# db    = screenshot bytes in Postgres/Neon (default; survives Render redeploys, no extra service)
# local = files on API disk (OK only for local docker; WIPED on Render redeploy)
# s3    = AWS S3 or Cloudflare R2
STORAGE_BACKEND=db
STORAGE_LOCAL_PATH=./data/uploads
# Max upload size in bytes (default ~1.5 MiB). Keep small on Neon free tier (0.5 GB).
STORAGE_MAX_UPLOAD_BYTES=1572864

# S3-compatible (only when STORAGE_BACKEND=s3)
# Cloudflare R2 example:
#   STORAGE_BACKEND=s3
#   S3_BUCKET=trader-os-uploads
#   S3_REGION=auto
#   S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- AI Intelligence (server-side only; never NEXT_PUBLIC_*) ---
# Failover order. Providers with an empty key are skipped.
AI_PROVIDER_ORDER=gemini,openrouter,bazaarlink
AI_TIMEOUT_SECONDS=45
AI_PROMPT_VERSION=2026-08-21.v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

BAZAARLINK_API_KEY=
BAZAARLINK_MODEL=google/gemini-2.0-flash

# --- Market data (server-side only; never NEXT_PUBLIC_*) ---
# Dukascopy historical/delayed FX is used without credentials.
# OANDA Practice is optional fallback. Leave empty to run without OANDA.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
CCXT_EXCHANGES=binance,bybit,kraken
MARKET_HTTP_TIMEOUT_SECONDS=8
MARKET_OHLCV_LIMIT=500

# --- Journal reminders (Web Push). Empty keys disable the feature. ---
# Generate with: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key.decode()); print(v.private_key.decode())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:trader-os@localhost
CRON_SECRET=
JOURNAL_REMINDER_HOUR=18
WEB_ORIGIN=http://localhost:3000

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
